# OpenRouter API configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Slack Socket Mode tokens
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-1-your-slack-app-token

# Local dataset directory (used in local development when Drive vars are unset or DATA_SOURCE=local
DATA_DIR=./Data

# Read-only Google Drive dataset access (used in deployment when both vars are set)
# GOOGLE_DRIVE_FOLDER_ID=x
# GOOGLE_SERVICE_ACCOUNT_JSON=x